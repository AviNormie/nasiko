  "groups": {
    "Stack": {
      "group": "Layout",
      "summary": "A vertical (default) or horizontal list of components, evenly spaced. The default container for a short dashboard."
    },
    "Grid": {
      "group": "Layout",
      "summary": "The only container that can express proportion between children. `columns: 2` for equal columns, or a ratio like \"2fr 1fr\" to make one child wider (the chart/subject side goes first). Omit `columns` for a responsive grid of similar cards."
    },
    "Card": {
      "group": "Layout",
      "summary": "A titled panel with its own edge. Use the moment two things on the page need telling apart (e.g. two charts side by side) — do not nest a Card inside a Card."
    },
    "Text": {
      "group": "Layout",
      "summary": "\"title\" for a heading above a group, \"subtitle\" for a heading inside one, \"body\" for one plain sentence, \"caption\" for a qualification the numbers need (period/units/exclusions), \"label\" for a short uppercase eyebrow naming a scope. Give any group of more than two components a title; at most one or two sentences of body text per dashboard."
    },
    "BarChart": {
      "group": "Charts",
      "summary": "Grouped or stacked bars across categories — one or more numeric series per row."
    },
    "LineChart": {
      "group": "Charts",
      "summary": "A trend over time — one or more numeric series plotted as lines against a date axis."
    },
    "AreaChart": {
      "group": "Charts",
      "summary": "A trend over time, filled below the line — good for cumulative or volume-like series."
    },
    "ComposedChart": {
      "group": "Charts",
      "summary": "Mixes bar/line/area series on one shared time axis — use when two metrics need different visual weight on the same chart (e.g. spend as bars, latency as a line)."
    },
    "PieChart": {
      "group": "Charts",
      "summary": "A breakdown of a whole into labeled slices. Set innerRadius for a donut."
    },
    "Gauge": {
      "group": "Charts",
      "summary": "A single-value gauge (0-100 fill), for one metric against an implicit or explicit cap."
    },
    "HeatmapChart": {
      "group": "Charts",
      "summary": "A compact GitHub-style calendar heatmap with fixed small cells — daily intensity over trailing weeks, good for spend/activity concentration."
    },
    "KpiStrip": {
      "group": "KPI",
      "summary": "A row of KPI stat cards with delta badges. Use for the top-level metrics of a dashboard — always pass every metric as one call, never one card per statement."
    },
    "InlineStatRow": {
      "group": "KPI",
      "summary": "Plain label/value pairs with no card chrome — lighter than KpiStrip, for quick context above a chart."
    },
    "FilterBar": {
      "group": "Controls",
      "summary": "A structured filter bar over a bounded set of fields (agent, model, provider, range). Supply each field's option list from a prior Query's real data — never invent options."
    },
    "AttributionTable": {
      "group": "Data",
      "summary": "The real per-agent cost/usage attribution table, server-paged at no more than 10 rows with Previous/Next controls. Filter with range/agentId/model — never invent an agent or model name not seen in a prior Query result."
    }
  },
  "groupNotes": {
    "Layout": "Stack is the default container. Reach for Grid the moment proportion matters (a chart beside its supporting numbers, a chart leading a table of the same rows). Use Card the moment two things on the page need telling apart — never nest a Card inside a Card.",
    "Charts": "Pick by the question, not by variety: a trend over time is LineChart/AreaChart, a breakdown of a whole is PieChart or a breakdown BarChart, one metric against a cap is Gauge, two metrics needing different visual weight on one axis is ComposedChart, daily activity concentration is HeatmapChart.",
    "KPI": "KpiStrip is the default for a dashboard's headline numbers — pass every metric in ONE call, never one card per statement. Use InlineStatRow only for lighter, secondary context above another component (e.g. a heatmap's summary stats).",
    "Controls": "FilterBar's field options must come from a prior Query's real data — never invent an agent or model name.",
    "Data": "AttributionTable is the one real, paged data table — filter it, don't try to reimplement it with other components."
  }
}
